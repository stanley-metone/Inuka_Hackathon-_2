@app.route("/")
def index():
    return render_template("dashboard.html")


@app.route("/api/health")
def health():
    conn = db.get_conn()
    summary = db.get_summary(conn)
    conn.close()
    return jsonify({
        "status": "ok",
        "service": "inuka-me-console",
        "model_metrics": model.metrics,
        "totals": summary,
    })


@app.route("/api/events/ingest", methods=["POST"])
def api_ingest():
    raw = request.get_json(force=True)
    if not raw:
        return jsonify({"error": "JSON body required"}), 400
    result = ingest_event(raw)
    return jsonify(result), 201


@app.route("/api/events/recent")
def api_recent():
    limit = int(request.args.get("limit", 50))
    conn = db.get_conn()
    events = db.get_recent_events(conn, limit)
    conn.close()
    # Anonymization-by-design: the raw beneficiary_id exists in the DB for
    # internal dedup purposes only and must never leave the API surface.
    for e in events:
        e.pop("beneficiary_id", None)
        e.pop("dedup_key", None)
    return jsonify(events)


