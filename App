@app.route("/api/events/stream")
def api_stream():
    """Server-Sent Events: the browser holds this connection open and the
    server pushes data down it the instant something happens -- genuine
    push, not the browser polling in a loop."""
    q = queue.Queue(maxsize=200)
    with _subscribers_lock:
        _subscribers.append(q)

    def gen():
        try:
            conn = db.get_conn()
            yield f"data: {json.dumps({'type':'summary','payload':db.get_summary(conn)})}\n\n"
            conn.close()
            while True:
                try:
                    data = q.get(timeout=15)
                    yield f"data: {data}\n\n"
                except queue.Empty:
                    yield ": keepalive\n\n"
        finally:
            with _subscribers_lock:
                if q in _subscribers:
                    _subscribers.remove(q)

    return Response(gen(), mimetype="text/event-stream", headers={
        "Cache-Control": "no-cache", "X-Accel-Buffering": "no", "Connection": "keep-alive",
    })


@app.route("/api/simulator/control", methods=["POST"])
def api_simulator_control():
    body = request.get_json(force=True) or {}
    action = body.get("action")
    speed = float(body.get("speed", 1.0))
    conn = db.get_conn()

    if action == "start":
        start_simulator(speed)
        db.set_simulator_state(conn, running=1, speed=speed, started_at=db.now_iso())
    elif action == "stop":
        stop_simulator()
        db.set_simulator_state(conn, running=0)
    elif action == "speed":
        db.set_simulator_state(conn, speed=speed)

    state = db.get_simulator_state(conn)
    conn.close()
    broadcast("simulator_state", state)
    return jsonify(state)


@app.route("/api/simulator/state")
def api_simulator_state():
    conn = db.get_conn()
    state = db.get_simulator_state(conn)
    conn.close()
    return jsonify(state)


# ------------------------------------------------------------- simulator --

BASE_URL = "http://127.0.0.1:5000"


def simulator_worker():
    import requests
    conn = db.get_conn()
    state = db.get_simulator_state(conn)
    events = pipeline.generate_event_stream()
    cursor = state["cursor"] if state["cursor"] < len(events) else 0
    conn.close()

    while not _sim_stop_flag.is_set():
        conn = db.get_conn()
        state = db.get_simulator_state(conn)
        conn.close()
        if not state["running"]:
            time.sleep(0.3)
            continue

        if cursor >= len(events):
            cursor = 0  # loop the stream so the demo never "runs dry"

        event = events[cursor]
        cursor += 1
        try:
            # Genuine HTTP call to our own API -- proves the endpoint
            # actually works under real network calls, not just a
            # function call shared in-process.
            requests.post(f"{BASE_URL}/api/events/ingest", json=event, timeout=3)
        except Exception as e:
            print("simulator ingest error:", e)

        conn = db.get_conn()
        db.set_simulator_state(conn, cursor=cursor)
        speed = db.get_simulator_state(conn)["speed"]
        conn.close()
        time.sleep(max(0.05, 1.0 / max(0.1, speed)))


def start_simulator(speed=1.0):
    global _sim_thread
    _sim_stop_flag.clear()
    if _sim_thread is None or not _sim_thread.is_alive():
        _sim_thread = threading.Thread(target=simulator_worker, daemon=True)
        _sim_thread.start()


def stop_simulator():
    conn = db.get_conn()
    db.set_simulator_state(conn, running=0)
    conn.close()


def create_app():
    db.init_db(reset=False)
    print("Training dropout-risk model...")
    metrics = model.train()
    print("Model metrics:", metrics)
    return app


if __name__ == "__main__":
    create_app()
    app.run(host="0.0.0.0", port=5000, threaded=True, debug=False)
