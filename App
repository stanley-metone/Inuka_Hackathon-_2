app.py — Inuka M&E Console backend.

Run:
    pip install -r requirements.txt
    python app.py
Then open http://localhost:5000

This is a real persistent server: a real SQLite database on disk, a real
background thread that ingests events independently of any connected
browser, and a real Server-Sent Events stream pushing live updates. Kill
the process, restart it, and your data is still there — that's the
difference between this and a client-side simulation.
"""

import json
import queue
import threading
import time

from flask import Flask, request, jsonify, Response, render_template

import db
import pipeline

app = Flask(__name__)

model = pipeline.DropoutModel()
_subscribers = []  # list of Queue objects, one per connected SSE client
_subscribers_lock = threading.Lock()
_sim_thread = None
_sim_stop_flag = threading.Event()


def broadcast(event_type: str, payload: dict):
    """Push an event to every connected SSE client."""
    data = json.dumps({"type": event_type, "payload": payload})
    with _subscribers_lock:
        dead = []
        for q in _subscribers:
            try:
                q.put_nowait(data)
            except queue.Full:
                dead.append(q)
        for q in dead:
            _subscribers.remove(q)


def ingest_event(raw: dict) -> dict:
    """The single ingestion path used by BOTH the public API and the
    background simulator -- there is exactly one pipeline, not two."""
    conn = db.get_conn()
    violations = pipeline.validate_row(raw)

    if violations:
        db.insert_quarantine(conn, raw, violations)
        conn.close()
        result = {"status": "quarantined", "violations": violations, "beneficiary_id": raw.get("beneficiary_id")}
        broadcast("quarantine", result)
        return result

    attendance = float(raw["attendance_pct"])
    days_inactive = float(raw["days_since_last_activity"])
    risk = model.predict_risk(attendance, days_inactive)
    at_risk = risk >= pipeline.OPERATING_THRESHOLD and raw["milestone_status"] not in ("Dropped", "Completed")

    row = {
        "beneficiary_id": raw["beneficiary_id"],
        "beneficiary_token": pipeline.tokenize(raw["beneficiary_id"]),
        "pillar": raw["pillar"],
        "region": raw["region"],
        "application_date": raw.get("application_date"),
        "milestone_status": raw["milestone_status"],
        "attendance_pct": attendance,
        "days_since_last_activity": days_inactive,
        "disbursement_amount": float(raw["disbursement_amount"]),
        "risk_score": risk,
        "at_risk": at_risk,
        "dedup_key": pipeline.dedup_key(raw),
    }
    inserted = db.insert_event(conn, row)

    if not inserted:
        conn.close()
        result = {"status": "duplicate", "beneficiary_id": raw.get("beneficiary_id")}
        broadcast("duplicate", result)
        return result

    summary = db.get_summary(conn)
    conn.close()

    result = {
        "status": "ingested",
        "beneficiary_token": row["beneficiary_token"],
        "pillar": row["pillar"],
        "region": row["region"],
        "milestone_status": row["milestone_status"],
        "risk_score": round(risk, 3),
        "at_risk": at_risk,
    }
    broadcast("event", result)
    broadcast("summary", summary)
    if at_risk:
        broadcast("alert", {
            "beneficiary_token": row["beneficiary_token"], "pillar": row["pillar"],
            "region": row["region"], "risk_score": round(risk, 3),
            "attendance_pct": attendance, "days_since_last_activity": days_inactive,
        })
    return result


